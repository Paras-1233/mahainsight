generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model District {
  id        Int     @id @default(autoincrement())
  name      String  @unique
  latitude  Float
  longitude Float
  region    String?

  weather           Weather[]
  rainfall          Rainfall[]
  rainfallSnapshots RainfallSnapshot[]
  crops             Crop[]
}

model Weather {
  id Int @id @default(autoincrement())

  temperature Float
  humidity    Float
  windSpeed   Float

  createdAt DateTime @default(now())

  districtId Int
  district   District @relation(fields: [districtId], references: [id])

  @@index([districtId, createdAt])
}

model Rainfall {
  id Int @id @default(autoincrement())

  rainfall Float
  year     Int

  districtId Int
  district   District @relation(fields: [districtId], references: [id])

  @@unique([districtId, year])
}

model RainfallSnapshot {
  id Int @id @default(autoincrement())

  rainfall           Float
  todayRainfall      Float
  currentRainfall    Float
  precipitationHours Float
  probability        Float
  temperature        Float?
  humidity           Float?
  windSpeed          Float?
  source             String   @default("Open-Meteo")
  observedAt         DateTime
  createdAt          DateTime @default(now())

  districtId Int
  district   District @relation(fields: [districtId], references: [id])

  @@unique([districtId, observedAt])
  @@index([districtId, observedAt])
  @@index([createdAt])
}

model Crop {
  id Int @id @default(autoincrement())

  name         String
  season       String
  rainfallType String

  districtId Int
  district   District @relation(fields: [districtId], references: [id])

  @@index([districtId])
}

model User {
  id String @id @default(cuid())

  name     String
  email    String @unique
  password String

  image String?

  createdAt DateTime @default(now())
}

model ApiRateLimit {
  id        String   @id
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}
